{
  "version": "purchase-segments-v1",
  "understood_as": "Learn past-only customer cadence-change groups and item repurchase speed, route customer-product predictions to specialists, prioritize early cart readiness over symmetric date accuracy.",
  "reference_protocol": "config/cadence-groups-full-v1.json",
  "minimum_gaps": 4,
  "recent_gaps": 6,
  "stable_cv_max": 0.25,
  "trend_relative_change_min": 0.3,
  "trend_direction_fraction_min": 0.75,
  "product_recent_intervals": 100,
  "minimum_product_intervals": 20,
  "minimum_product_customers": 5,
  "minimum_specialist_rows": 200,
  "minimum_specialist_customers": 30,
  "rounds": 150,
  "params": {"tree_method":"hist","device":"cpu","eta":0.05,"max_depth":4,"min_child_weight":10,"lambda":1,"subsample":1,"colsample_bytree":1,"seed":42,"nthread":4},
  "candidates": [
    {"id":"base_q50","features":"base","alpha":0.5,"specialists":false},
    {"id":"patterns_q50","features":"patterns","alpha":0.5,"specialists":false},
    {"id":"patterns_items_q50","features":"all","alpha":0.5,"specialists":false},
    {"id":"patterns_items_q25","features":"all","alpha":0.25,"specialists":false},
    {"id":"specialists_q50","features":"all","alpha":0.5,"specialists":true},
    {"id":"specialists_q25","features":"all","alpha":0.25,"specialists":true}
  ],
  "cart_policies": ["none","lead7","lead10","relative25_cap7"],
  "selection": "No automatic promotion. Compare late/same-day, 1-10-day early, >30-day early, next-day suggestions, quantity errors and non-return suggestions together. No post-score threshold tuning.",
  "operational_approval": false,
  "independent_final_test": false
}
